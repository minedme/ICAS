<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.QuizMapper">
    <resultMap id="BaseResultMap" type="com.example.demo.model.Quiz">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="teacher_id" property="teacherId" />
        <result column="course_name" property="courseName" />
        <result column="start_time" property="startTime" />
        <result column="end_time" property="endTime" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.Quiz" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO quiz (title, teacher_id, course_name, start_time, end_time, status, create_time)
        VALUES (#{title}, #{teacherId}, #{courseName}, #{startTime}, #{endTime}, #{status}, #{createTime})
    </insert>

    <update id="update" parameterType="com.example.demo.model.Quiz">
        UPDATE quiz
        SET title = #{title},
            teacher_id = #{teacherId},
            course_name = #{courseName},
            start_time = #{startTime},
            end_time = #{endTime},
            status = #{status}
        WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="int" resultMap="BaseResultMap">
        SELECT * FROM quiz WHERE id = #{id}
    </select>

    <select id="selectByTeacherId" parameterType="int" resultMap="BaseResultMap">
        SELECT * FROM quiz WHERE teacher_id = #{teacherId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM quiz
    </select>

    <update id="updateStatus">
        UPDATE quiz SET status = #{status} WHERE id = #{id}
    </update>
    
    <delete id="delete" parameterType="int">
        DELETE FROM quiz WHERE id = #{id}
    </delete>
</mapper>